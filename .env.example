MYSQL_ROOT_PASSWORD=ganti-root-password
MYSQL_PASSWORD=ganti-password-forma
AUTH_SECRET=ganti-secret-panjang-minimal-48-karakter
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Dipakai hanya kalau menjalankan `pnpm dev` di laptop dengan MySQL dari compose.
DATABASE_URL=mysql://forma:ganti-password-forma@127.0.0.1:3307/fitnes_sehat

# Untuk Vercel + TiDB, pakai connection string TiDB, misalnya:
# DATABASE_URL=mysql://user:pass@host.tidbcloud.com:4000/database?sslaccept=strict
# Opsional; default 3, maksimal 5.
DB_CONNECTION_LIMIT=3
