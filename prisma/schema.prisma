generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

model User {
  id             String          @id @default(cuid())
  email          String          @unique
  name           String?
  bio            String?
  club           String   @default("Downtown Club")
  avatar         String?  @db.LongText
  passwordHash   String
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  photos         Photo[]
  stories        Story[]
  communityPosts CommunityPost[]
}

model Photo {
  id        String       @id @default(cuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  caption   String?
  likes     Int          @default(0)
  createdAt DateTime     @default(now())
  images    PhotoImage[]
}

model PhotoImage {
  id      String @id @default(cuid())
  photoId String
  photo   Photo  @relation(fields: [photoId], references: [id], onDelete: Cascade)
  url     String @db.LongText
  order   Int    @default(0)
}

model Story {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  mediaUrl  String   @db.LongText
  caption   String?
  createdAt DateTime @default(now())
}

model CommunityPost {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category  String
  imageUrl  String   @db.LongText
  caption   String?
  createdAt DateTime @default(now())
}
